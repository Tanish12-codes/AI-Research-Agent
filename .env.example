# ---------------------------------------------------------------------------
# AI Research Agent configuration
# Everything below can run on FREE tiers. The minimum is one free LLM key;
# web search works with no key at all (DuckDuckGo + Wikipedia).
# ---------------------------------------------------------------------------

# LLM provider: auto | gemini | groq | openrouter | ollama | openai | anthropic | mock
#   auto = use every configured provider, free ones first, failing over on
#          rate limits / outages (groq > gemini > openrouter > ollama > openai > anthropic)
LLM_PROVIDER=auto
# Leave empty to use the provider's default model. Ignored when LLM_PROVIDER=auto.
LLM_MODEL=

# Free LLM keys (set any one or more)
GEMINI_API_KEY=            # https://aistudio.google.com/apikey     (chains 2.5-flash > flash-lite-latest > flash-latest)
GROQ_API_KEY=              # https://console.groq.com/keys          (default: llama-3.3-70b-versatile)
OPENROUTER_API_KEY=        # https://openrouter.ai/keys             (default: llama-3.3-70b-instruct:free)
# OLLAMA_BASE_URL=http://localhost:11434/v1   # local models, no key, no cost

# Paid LLM keys (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Search. Keyed providers are tried first; keyless ones are the fallback.
TAVILY_API_KEY=            # free tier: 1,000 searches/month  https://tavily.com
BRAVE_API_KEY=             # free tier: 2,000 queries/month   https://brave.com/search/api
ENABLE_FREE_SEARCH=true    # DuckDuckGo + Wikipedia, no key needed

# Academic papers for research-style questions (arXiv needs no key; a free
# Semantic Scholar key avoids its shared public rate limit)
ENABLE_PAPER_SEARCH=true
SEMANTIC_SCHOLAR_API_KEY=  # https://www.semanticscholar.org/product/api#api-key-form

# GitHub metadata tool (optional; raises rate limit from 60 to 5,000 req/hour)
GITHUB_TOKEN=

# Budgets and timeouts
MAX_CONCURRENT_SEARCHES=3
SEARCH_TIMEOUT_SECONDS=15
LLM_TIMEOUT_SECONDS=45
CACHE_TTL_SECONDS=3600
MAX_TOOL_CALLS_PER_RUN=20
MAX_LLM_CALLS_PER_RUN=10
MAX_WALL_CLOCK_SECONDS=150
CONFIDENCE_THRESHOLD=0.3

# Retries (each attempt counts against the budgets above)
MAX_RETRIES=2
RETRY_BASE_DELAY_SECONDS=0.5
